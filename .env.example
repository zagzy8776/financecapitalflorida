# Copy this file to .env and fill in real values
# NEVER commit the real .env file to GitHub
# On Vercel: set these in Project → Settings → Environment Variables

# --- Database (Aiven for PostgreSQL) ---
# Prefer DATABASE_URL (single connection string). The app also accepts split PG* vars.
# IMPORTANT: never put the real password in any committed file.

DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD_HERE@credit-credit.k.aivencloud.com:22974/defaultdb?sslmode=require

PGHOST=credit-credit.k.aivencloud.com
PGPORT=22974
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD=YOUR_PASSWORD_HERE
PGSSLMODE=require

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# Owner email becomes admin role on self-registration (optional)
OWNER_EMAIL=your-email@example.com

# Env-based admin login (separate from customer accounts)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=YourSecureAdminPassword

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Finance Capital Florida <noreply@yourdomain.com>
SUPPORT_EMAIL=support@yourdomain.com
APP_URL=https://your-vercel-app.vercel.app

# --- External cron (cron-job.org) ---
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-long-random-string

PORT=4000
